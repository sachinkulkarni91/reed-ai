# --- Claude (required for summarization / Ask-AI) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
REED_MODEL=claude-opus-5
REED_EFFORT=high

# --- Transcription provider: whisper | sarvam | deepgram | mock ---
# whisper = free, fully local (live captions + final transcript)
# sarvam  = live captions stay local; final transcript from Sarvam Saaras -
#           much better for Hinglish / code-mixed Indian meetings
TRANSCRIPTION_PROVIDER=sarvam
WHISPER_MODEL=base
# Speaker diarization (who spoke when). Get a free token at huggingface.co,
# then accept the model terms at hf.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your-huggingface-token

# Sarvam (dashboard.sarvam.ai) - used when TRANSCRIPTION_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_MODE=codemix
SARVAM_LANGUAGE=unknown

# Only needed if TRANSCRIPTION_PROVIDER=deepgram (live captions + diarization)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Trello (action-item push target) ---
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
TRELLO_AUTO_PUSH=false

# --- Bot ---
BOT_DISPLAY_NAME=Reed AI Notetaker
BOT_HEADLESS=false
BOT_MAX_MEETING_MINUTES=180

# --- Server ---
DATABASE_URL=sqlite:///./data/reed.db
MEDIA_DIR=./data/media
CORS_ORIGINS=http://localhost:5173
